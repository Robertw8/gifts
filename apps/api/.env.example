DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gifts?schema=public
TELEGRAM_BOT_TOKEN=replace-with-bot-token
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
NODE_ENV=development
ENABLE_DEVELOPMENT_BONUS=false
DEVELOPMENT_BONUS_AMOUNT=1000
ENABLE_DEVELOPMENT_GIFT_FALLBACK=false
ENABLE_DEVELOPMENT_SEED=false
TELEGRAM_BOT_API_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
PUBLIC_API_URL=http://localhost:3000/api
WEB_ORIGIN=http://localhost:5173
ADMIN_TELEGRAM_IDS=123456789
PORT=3000
